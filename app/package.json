{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push --skip-generate >/dev/null 2>&1; next dev",
    "build": "next build",
    "start": "prisma db push --skip-generate && next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "init:devnet": "tsx --tsconfig tsconfig.json scripts/with-env.ts scripts/init-devnet.ts",
    "seed:demo": "tsx --tsconfig tsconfig.json scripts/with-env.ts scripts/seed-demo.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@anchor-lang/core": "1.2.2",
    "@solana/web3.js": "^1.99.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@prisma/client": "6.19.3",
    "@noble/curves": "^1.9.0",
    "bn.js": "^5.2.2",
    "bs58": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0",
    "@types/bn.js": "^5.2.0"
  }
}
