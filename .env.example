# Copy to .env.local (repo root) and fill in. Never commit .env.local.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: pin a model, otherwise the newest Flash model is picked automatically
GEMINI_MODEL=

# Optional overrides
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# JUDGE_KEYPAIR=keys/judge.json            # or JUDGE_SECRET_KEY=<base58 or JSON array>
# CRANK_KEYPAIR=~/.config/solana/id.json   # or CRANK_SECRET_KEY=...
# DEMO_KEY=some-secret                     # require a key on the /demo panel API
# SCHEDULER=off                            # disable the background scheduler
